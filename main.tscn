[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_main_menu"]
[ext_resource type="Theme" path="res://ui/theme_valorant.tres" id="2_theme"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_main_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0588235, 0.0980392, 0.137255, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuBox" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/MenuBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.27451, 0.333333, 1)
theme_override_font_sizes/font_size = 44
text = "无畏契约灵敏度测试"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/MenuBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92549, 0.909804, 0.882353, 0.65)
theme_override_font_sizes/font_size = 16
text = "找到属于你的最佳灵敏度"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="TestSelectButton" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "灵敏度测试"

[node name="HistoryButton" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "历史记录"

[node name="SettingsButton" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "设置"

[node name="AboutButton" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "关于 / 用户指南"

[node name="QuitButton" type="Button" parent="Center/MenuBox"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "退出"

[connection signal="pressed" from="Center/MenuBox/TestSelectButton" to="." method="_on_test_select_button_pressed"]
[connection signal="pressed" from="Center/MenuBox/HistoryButton" to="." method="_on_history_button_pressed"]
[connection signal="pressed" from="Center/MenuBox/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/MenuBox/AboutButton" to="." method="_on_about_button_pressed"]
[connection signal="pressed" from="Center/MenuBox/QuitButton" to="." method="_on_quit_button_pressed"]
