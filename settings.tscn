[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/settings_menu.gd" id="1_settings"]
[ext_resource type="Script" path="res://scripts/back_button.gd" id="2_back"]
[ext_resource type="Theme" path="res://ui/theme_valorant.tres" id="3_theme"]
[ext_resource type="PackedScene" path="res://ui/top_bar.tscn" id="4_top"]

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_settings")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0588235, 0.0980392, 0.137255, 1)

[node name="TopBar" parent="." instance=ExtResource("4_top")]
title_text = "设置"

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Center/Card/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Center/Card/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.27451, 0.333333, 1)
theme_override_font_sizes/font_size = 28
text = "设置"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="Center/Card/Margin/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 14
columns = 2

[node name="DpiLabel" type="Label" parent="Center/Card/Margin/VBox/Grid"]
layout_mode = 2
text = "鼠标 DPI"
vertical_alignment = 1

[node name="DpiSpin" type="SpinBox" parent="Center/Card/Margin/VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
min_value = 100.0
max_value = 10000.0
step = 50.0
value = 800.0

[node name="FovLabel" type="Label" parent="Center/Card/Margin/VBox/Grid"]
layout_mode = 2
text = "游戏内 FOV（水平 103 / 垂直 70.5）"
vertical_alignment = 1

[node name="FovSpin" type="SpinBox" parent="Center/Card/Margin/VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
min_value = 60.0
max_value = 120.0
step = 0.5
value = 103.0

[node name="VolumeLabel" type="Label" parent="Center/Card/Margin/VBox/Grid"]
layout_mode = 2
text = "音量"
vertical_alignment = 1

[node name="VolumeBox" type="HBoxContainer" parent="Center/Card/Margin/VBox/Grid"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
theme_override_constants/separation = 12

[node name="VolumeSlider" type="HSlider" parent="Center/Card/Margin/VBox/Grid/VolumeBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
max_value = 100.0
value = 100.0

[node name="VolumeValue" type="Label" parent="Center/Card/Margin/VBox/Grid/VolumeBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 0)
layout_mode = 2
text = "100%"
horizontal_alignment = 2

[node name="UiScaleLabel" type="Label" parent="Center/Card/Margin/VBox/Grid"]
layout_mode = 2
text = "UI 缩放"
vertical_alignment = 1

[node name="UiScaleOption" type="OptionButton" parent="Center/Card/Margin/VBox/Grid"]
