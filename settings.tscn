popup/item_0/text = "自动"
popup/item_1/text = "100%"
popup/item_2/text = "125%"
popup/item_3/text = "150%"

[node name="DisplayModeLabel" type="Label" parent="Center/Card/Margin/VBox/Grid"]
layout_mode = 2
