[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/test_select.gd" id="1_select"]
[ext_resource type="Script" path="res://scripts/back_button.gd" id="2_back"]
[ext_resource type="Theme" path="res://ui/theme_valorant.tres" id="3_theme"]

[sub_resource type="ButtonGroup" id="ButtonGroup_type"]

[node name="TestSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_select")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0588235, 0.0980392, 0.137255, 1)

[node name="TitleBar" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 80.0
grow_horizontal = 2
theme_override_colors/font_color = Color(1, 0.27451, 0.333333, 1)
theme_override_font_sizes/font_size = 32
text = "测试选择"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Separator" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 80.0
offset_bottom = 82.0
grow_horizontal = 2
color = Color(1, 0.27451, 0.333333, 0.6)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Center/Card/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="SectionTitle" type="Label" parent="Center/Card/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.27451, 0.333333, 1)
theme_override_font_sizes/font_size = 20
text = "选择测试类型"

[node name="PsaButton" type="Button" parent="Center/Card/Margin/VBox"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_type")
text = "二分法 (PSA)\n快速逼近最适合你的灵敏度"

[node name="ConsistencyButton" type="Button" parent="Center/Card/Margin/VBox"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_type")
text = "Consistency 测试\n验证瞄准稳定性与一致性"

[node name="Spacer" type="Control" parent="Center/Card/Margin/VBox"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="InfoButton" type="Button" parent="Center/Card/Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "查看测试说明"

[node name="InfoDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "测试说明"
dialog_text = "二分法 (PSA)：通过多轮测试不断缩小灵敏度范围，快速逼近最适合你的灵敏度。\n\nConsistency 测试：在固定灵敏度下重复多轮测试，评估你的瞄准稳定性与一致性。"
ok_button_text = "知道了"

[node name="BottomBar" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -100.0
offset_bottom = -28.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 12
alignment = 2

[node name="BackButton" type="Button" parent="BottomBar"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
text = "返回主菜单"
script = ExtResource("2_back")

[node name="StartButton" type="Button" parent="BottomBar"]
custom_minimum_size = Vector2(180, 56)
layout_mode = 2
text = "开始测试"

[connection signal="pressed" from="Center/Card/Margin/VBox/InfoButton" to="." method="_on_info_button_pressed"]
[connection signal="pressed" from="BottomBar/StartButton" to="." method="_on_start_button_pressed"]
